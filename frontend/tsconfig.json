{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": "./src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
//    "allowImportingTsExtensions": true,
    "noEmit": false,
  },
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
